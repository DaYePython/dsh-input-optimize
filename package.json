{
  "name": "dsh-input-optimize",
  "version": "0.1.2",
  "description": "输入框提示词优化按钮：一键调用当前选中模型优化用户提示词，保留引用 chip，失败原因走 tooltip",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaYePython/dsh-input-optimize.git"
  },
  "homepage": "https://github.com/DaYePython/dsh-input-optimize#readme",
  "bugs": {
    "url": "https://github.com/DaYePython/dsh-input-optimize/issues"
  },
  "author": "DaYePython",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./client/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check lib/index.js && node --check client/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "prompt",
    "optimize",
    "composer"
  ],
  "license": "MIT"
}
